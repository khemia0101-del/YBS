# YBS OS — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to git.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://ybs:changeme@db:5432/ybs_os
DATABASE_URL_SYNC=postgresql://ybs:changeme@db:5432/ybs_os

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=CHANGE_ME_USE_openssl_rand_-hex_32
ENCRYPTION_KEY=CHANGE_ME_USE_Fernet.generate_key()
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── S3-Compatible Storage ─────────────────────────────────────────────────────
S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
S3_BUCKET=ybs-os-files
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_REGION=nyc3

# ── QuickBooks Online ─────────────────────────────────────────────────────────
QB_CLIENT_ID=CHANGE_ME
QB_CLIENT_SECRET=CHANGE_ME
QB_REDIRECT_URI=http://localhost:3000/integrations/quickbooks/callback
QB_ENVIRONMENT=sandbox

# ── Plaid (bank account access) ───────────────────────────────────────────────
PLAID_CLIENT_ID=CHANGE_ME
PLAID_SECRET=CHANGE_ME
PLAID_ENV=sandbox

# ── Google / Gmail ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=http://localhost:3000/integrations/gmail/callback

# ── Anthropic (AI features) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=CHANGE_ME
ANTHROPIC_MODEL=claude-opus-4-7

# ── Swept ─────────────────────────────────────────────────────────────────────
SWEPT_API_KEY=CHANGE_ME
SWEPT_API_BASE_URL=https://api.swept.com/v1

# ── Notifications ─────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_OPERATOR_CHAT_ID=CHANGE_ME
SENDGRID_API_KEY=CHANGE_ME
NOTIFICATIONS_FROM_EMAIL=noreply@ybs-os.internal

# ── Agent Configuration ───────────────────────────────────────────────────────
HERMES_API_URL=http://hermes:8001
OPENCLAW_API_URL=http://openclaw:8002
AGENT_CONFIDENCE_AUTO_APPROVE=0.92
AGENT_CONFIDENCE_NEEDS_REVIEW=0.70

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
API_V1_PREFIX=/api/v1

# ── Celery Beat Schedule ──────────────────────────────────────────────────────
DAILY_LOOP_HOUR_UTC=6
WEEKLY_LOOP_DAY=6
WEEKLY_LOOP_HOUR_UTC=4
